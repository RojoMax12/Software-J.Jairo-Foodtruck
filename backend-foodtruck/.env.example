APP_NAME="J.Jairo Foodtruck API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.foodtruck-jjairo.com
FRONTEND_URL=https://foodtruck-jjairo.com
CORS_ALLOWED_ORIGINS=https://foodtruck-jjairo.com

# Generar clave aleatoria segura (ej: openssl rand -base64 48)
JWT_SECRET=
JWT_TTL=60

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_jjairo
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
